<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Hunk – Profile Page</title>
  <link rel="stylesheet" href="style.css" />
</head>
<body>
  <header>
    <h1>🔥 Hunk Profile</h1>
    <button id="theme-toggle">Toggle Theme</button>
  </header>

  <section class="hero">
    <img src="https://picsum.photos/300" alt="Hunk photo" class="avatar">
    <h2>John “Hunk” Doe</h2>
    <p>Fitness model • Gamer • Creator</p>
    <button class="follow-btn">Follow</button>
  </section>

  <section class="gallery">
    <h3>Gallery</h3>
    <div class="grid">
      <img src="https://picsum.photos/400?1" alt="">
      <img src="https://picsum.photos/400?2" alt="">
      <img src="https://picsum.photos/400?3" alt="">
      <img src="https://picsum.photos/400?4" alt="">
    </div>
  </section>

  <footer>
    <p>© 2025 Hunk Inc. | Built with ❤️ by Djden</p>
  </footer>

  <script src="script.js"></script>
</body>
</html>
